<?xml version="1.0" ?>
<sdf version='1.9'>
  <!--
    demo_cabinet – same stack as demo_car (UR5e + MoveIt + cartesian spray)
    but the paint target is a hand-written office_cabinet instead of a Prius.

    Cabinet placement keeps the EXISTING spray trajectory valid:
      * Robot base is at world (0, 0, 0.8), yaw 90 deg.
      * The pre-computed sweep (config/cartesian_poses.yaml) paints a band at
        world y ~= 0.36, z ~= 1.03, x in [-0.35, +0.35] (nozzle points +Y).
      * The Prius near side panel sat at world y ~= 0.945. The cabinet is
        placed so its front face (-Y, facing the robot) is at the same
        y = 0.945: model origin at y = 0.945 + depth/2 = 0.945 + 0.25.
      * No trajectory regeneration needed for the first verification.
  -->
  <world name="demo_cabinet">

    <!-- ── Core simulation plugins ── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter"/>

    <light name='sun' type='directional'>
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics name='5ms' type='dart'>
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Furniture target: office cabinet, front face at world y = 0.945 -->
    <include>
      <uri>model://office_cabinet</uri>
      <name>office_cabinet</name>
      <pose>0.0 1.195 0.0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Robot pedestal -->
    <model name='robot_pedestal'>
      <static>true</static>
      <pose>0.0 0.0 0.40 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.80</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.80</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.0 0.0 1</ambient>
            <diffuse>0.5 0.0 0.0 1</diffuse>
            <specular>0.2 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
